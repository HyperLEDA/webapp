{
  "name": "hyperleda-webapp",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "bun run --filter @hyperleda/web dev",
    "dev:admin": "bun run --filter @hyperleda/admin dev",
    "build:web": "bun run --filter @hyperleda/web build",
    "build:admin": "bun run --filter @hyperleda/admin build",
    "lint:web": "bun run --filter @hyperleda/web lint",
    "lint:admin": "bun run --filter @hyperleda/admin lint",
    "lint:lib": "bun run --filter @hyperleda/lib lint",
    "test:web": "bun run --filter @hyperleda/web test",
    "test:admin": "bun run --filter @hyperleda/admin test",
    "start": "node server.mjs",
    "prettier": "prettier",
    "openapi-ts": "openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "prettier": "3.9.6"
  }
}
