{
  "name": "leda-webapp",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "build:web": "bun run --cwd apps/web build",
    "build:admin": "bun run --cwd apps/admin build",
    "lint": "bun scripts/run-oxlint.mjs .",
    "oxlint": "bun scripts/run-oxlint.mjs",
    "test:web": "bun run --cwd apps/web test",
    "test:admin": "bun run --cwd apps/admin test",
    "start": "node server.mjs",
    "prettier": "prettier",
    "openapi-ts": "openapi-ts"
  },
  "dependencies": {
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@oxlint/plugins": "1.79.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-anti-slop": "git+https://github.com/dmmulroy/anti-slop.git",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6"
  }
}
