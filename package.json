{
  "name": "hyperleda-webapp",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "yarn workspace @hyperleda/web dev",
    "dev:admin": "yarn workspace @hyperleda/admin dev",
    "build:web": "yarn workspace @hyperleda/web build",
    "build:admin": "yarn workspace @hyperleda/admin build",
    "lint:web": "yarn workspace @hyperleda/web lint",
    "lint:admin": "yarn workspace @hyperleda/admin lint",
    "test:web": "yarn workspace @hyperleda/web test",
    "test:admin": "yarn workspace @hyperleda/admin test",
    "start": "node server.mjs"
  }
}
